# Copy to .env and fill in. Never commit .env.
# This file names variables. It holds no values, and no secret belongs here.

# --- Database -----------------------------------------------------------------
# Supabase or any PostgreSQL 15+ connection string.
DATABASE_URL=postgresql://pan:pan@localhost:5432/pan

# --- Crawler identity ---------------------------------------------------------
# Must name the crawler and link to a reachable page explaining the crawl and
# how to ask to be removed. The default in code points at example.invalid so an
# unconfigured deployment is obvious rather than anonymous.
CRAWLER_USER_AGENT=
CRAWLER_CONTACT_URL=

# --- Crawl limits (optional; defaults in DEFAULT_CRAWL_POLICY) -----------------
CRAWL_REQUEST_DELAY_MS=
CRAWL_MAX_PAGES_PER_RUN=
CRAWL_MAX_PAGES_PER_DOMAIN=

# --- Object storage for archived raw responses (not yet implemented) ----------
# S3-compatible, e.g. Cloudflare R2. See docs/BACKLOG.md.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Email validation provider ------------------------------------------------
# Leave unset to use the no-op provider, which marks everything unvalidated and
# cannot spend money.
VALIDATION_PROVIDER=
VALIDATION_API_KEY=

# --- Orchestration ------------------------------------------------------------
# n8n starts jobs and receives completion events. It never crawls pages.
N8N_WEBHOOK_URL=

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=info
