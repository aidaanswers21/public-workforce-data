# Copy to .env and fill in. Never commit .env.
# This file names variables. It holds no values, and no secret belongs here.
#
# WIRED means code reads it today. NOT WIRED means the variable is reserved for
# a feature that is not implemented, and setting it changes nothing. Naming a
# variable is not the same as wiring it, and a reader who assumes otherwise will
# configure a crawler identity that never reaches a request.

# --- Database -----------------------------------------------------------------
# WIRED: read by packages/database/src/cli/migrate.ts, apps/admin/src/cli.ts,
# apps/admin/src/server.ts, and the production collection worker.
# Supabase or any PostgreSQL 15+ connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/public_workforce_data

# --- Local operator console ---------------------------------------------------
# WIRED: read by apps/admin/src/server.ts and the persistent fixture setup.
# When DATABASE_URL is set, the console reads remote PostgreSQL and ignores the
# embedded database path. It still listens only on 127.0.0.1.
# Store real local values in .env.local, which is ignored by git.
LOCAL_DATABASE_PATH=
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_SESSION_SECRET=
ADMIN_PORT=

# --- Hosted operator console -------------------------------------------------
# WIRED: required when RENDER=true. The hosted console refuses to start with a
# plaintext password, a non-HTTPS public origin, or without DATABASE_URL.
# ADMIN_PASSWORD_HASH uses the documented scrypt format and belongs only in the
# hosting provider's secret environment settings.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_PUBLIC_ORIGIN=

# --- Supabase integration verification ---------------------------------------
# WIRED: used only by pnpm rls:verify and its isolated CI workflow. Use a
# publishable key, never a service-role key. The check asserts anonymous reads
# expose no rows from every application table.
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=

# --- Logging ------------------------------------------------------------------
# WIRED: read by packages/observability/src/logger.ts.
LOG_LEVEL=info

# --- Crawler identity ---------------------------------------------------------
# WIRED: required by the approved-batch collection worker. It refuses to start
# without both values, and the configured user agent reaches ordinary requests
# and robots.txt requests.
CRAWLER_USER_AGENT=
CRAWLER_CONTACT_URL=
WORKER_POLL_INTERVAL_MS=5000
# WIRED: bounded jobs across independent domains; default 4, maximum 10.
WORKER_CONCURRENCY=
# WIRED: one-time, fail-closed hosted import. Leave empty to disable. When set,
# this must equal the exact artifactId in the bundled accepted-contact manifest.
STARTUP_LEGACY_CONTACT_IMPORT_ARTIFACT_ID=
# WIRED: opt-in public JavaScript rendering. Comma-separated approved exact
# hostnames without schemes, ports, paths, or wildcards. Empty means disabled.
CRAWLER_RENDER_BROWSER_DOMAINS=
# WIRED: hard per-page browser limits. Defaults are 50 subresource attempts and
# 20,000 milliseconds; valid production maxima are 250 and 60,000.
CRAWLER_RENDER_BROWSER_MAX_SUBRESOURCES=50
CRAWLER_RENDER_BROWSER_DEADLINE_MS=20000

# --- Crawl limits -------------------------------------------------------------
# NOT WIRED. Limits come from DEFAULT_CRAWL_POLICY and per-jurisdiction
# overrides in the jurisdiction configuration.
CRAWL_REQUEST_DELAY_MS=
CRAWL_MAX_PAGES_PER_RUN=
CRAWL_MAX_PAGES_PER_DOMAIN=

# --- Object storage for archived raw responses --------------------------------
# WIRED: required by the production collection worker. Successful responses are
# compressed and written to a private S3-compatible bucket before parsing. The
# worker fails rather than ingesting evidence it could not archive.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Email validation provider ------------------------------------------------
# NOT WIRED. The shipped provider is NoopValidationProvider, which marks
# everything unvalidated and cannot spend money. No vendor is implemented.
VALIDATION_PROVIDER=
VALIDATION_API_KEY=

# --- Orchestration ------------------------------------------------------------
# NOT WIRED. No code path posts a webhook. If n8n is used it would start jobs
# and receive completion events; it would never crawl pages.
N8N_WEBHOOK_URL=
