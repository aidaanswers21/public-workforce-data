{
  "name": "public-workforce-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^10.0.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "db:migrate": "tsx packages/database/src/cli/migrate.ts",
    "crawl:fixture": "tsx services/crawler-worker/src/cli/fixture-crawl.ts",
    "admin": "tsx apps/admin/src/cli.ts",
    "local:setup": "tsx services/crawler-worker/src/cli/fixture-crawl.ts --persistent",
    "local:start": "tsx apps/admin/src/server.ts",
    "admin:serve": "node apps/admin/dist/server.js",
    "collection:work": "tsx services/crawler-worker/src/cli/collection-worker.ts",
    "collection:daemon": "node services/crawler-worker/dist/cli/collection-worker.js --daemon",
    "spine:organize": "tsx packages/jurisdiction-config/us-national-spine/src/cli.ts",
    "spine:import": "tsx packages/jurisdiction-config/us-national-spine/src/import-cli.ts",
    "texas:legacy-contacts": "tsx packages/jurisdiction-config/texas-education/src/legacy-contact-import-cli.ts",
    "texas:seed-uncovered-campuses": "tsx packages/jurisdiction-config/texas-education/src/uncovered-campus-targets-cli.ts",
    "texas:legacy-contacts:startup": "node packages/jurisdiction-config/texas-education/dist/legacy-contact-startup-cli.js",
    "rls:verify": "tsx scripts/verify-supabase-rls.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.0"
  }
}
