{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "@public-workforce/shared-types": ["packages/shared-types/src/index.ts"],
      "@public-workforce/observability": ["packages/observability/src/index.ts"],
      "@public-workforce/core": ["packages/core/src/index.ts"],
      "@public-workforce/extraction": ["packages/extraction/src/index.ts"],
      "@public-workforce/database": ["packages/database/src/index.ts"],
      "@public-workforce/adapter-kit": ["packages/directory-adapters/kit/src/index.ts"],
      "@public-workforce/adapter-generic-html": [
        "packages/directory-adapters/generic-html/src/index.ts"
      ],
      "@public-workforce/adapter-generic-json": [
        "packages/directory-adapters/generic-json/src/index.ts"
      ],
      "@public-workforce/taxonomy": ["packages/taxonomy/src/index.ts"],
      "@public-workforce/sector-education": ["packages/sectors/education/src/index.ts"],
      "@public-workforce/sector-state-local": [
        "packages/sectors/state-local-government/src/index.ts"
      ],
      "@public-workforce/sector-federal": ["packages/sectors/federal-government/src/index.ts"],
      "@public-workforce/jurisdiction-kit": ["packages/jurisdiction-config/kit/src/index.ts"],
      "@public-workforce/jurisdiction-texas-education": [
        "packages/jurisdiction-config/texas-education/src/index.ts"
      ],
      "@public-workforce/crawler-worker": ["services/crawler-worker/src/index.ts"],
      "@public-workforce/discovery-worker": ["services/discovery-worker/src/index.ts"],
      "@public-workforce/validation-worker": ["services/validation-worker/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "services/**/*.ts", "packages/**/*.ts", "tests/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "**/dist/**"]
}
